# Default to LF for text files across the repository
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary

# Repository skills are content-addressed generated artifacts. Preserve their
# exact bytes so Git EOL conversion cannot invalidate content_sha256 values.
skills/repositories/repo-skills/** -text -eol
