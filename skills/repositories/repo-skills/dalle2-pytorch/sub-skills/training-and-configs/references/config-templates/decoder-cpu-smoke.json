    "FID": null,
    "IS": null,
    "KID": null,
    "LPIPS": null
  },
  "tracker": {
    "data_path": "./runs/dalle2-decoder-tracker",
    "overwrite_data_path": true,
    "log": {
      "log_type": "console",
      "verbose": true
    },
    "load": null,
    "save": {
      "save_to": "local",
      "save_latest_to": "./runs/dalle2-decoder/latest.pth",
      "save_type": "checkpoint"
    }
  },
  "seed": 0
}
