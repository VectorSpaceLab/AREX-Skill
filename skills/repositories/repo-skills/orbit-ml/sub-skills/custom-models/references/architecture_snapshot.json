  "notebook_takeaways": [
    "A custom model needs a callable fitter plus predict().",
    "The tutorial uses ModelTemplate with _fitter = MyFitter, _data_input_mapper = [\"regressor\"], and _supported_estimator_types = [PyroEstimatorSVI].",
    "Forecaster is instantiated with model=custom_model and estimator_type=PyroEstimatorSVI."
  ],
  "runtime_notes": [
    "Direct import of orbit.template.ktr reproduces a circular ImportError because template/ktr.py imports ..models.KTRLite and orbit.models.__init__ imports orbit.models.ktr back again.",
    "orbit/utils/stan.py has a path-override branch bug: when stan_file_path or exe_file_path is supplied, it references stan_file before assignment.",
    "Current source tree does not ship orbit/stan_compiled/cmdstan-<version>; set_cmdstan_path() therefore falls back to the default ~/.cmdstan path when cmdstanpy is available."
  ]
}